; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UniverseCozySim"
run/main_scene="uid://boiq26uq3b7fc"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"

[autoload]

TimeManager="*res://scripts/core/TimeManager.cs"
StationResources="*res://scripts/core/StationResources.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="UniverseCozySim"

[internationalization]

locale/translations=PackedStringArray("res://localization/translations.it.translation", "res://localization/translations.en.translation")
locale/fallback="it"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
